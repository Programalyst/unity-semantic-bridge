# Copy to .env and fill in — never commit .env
# Lighting diagnostic sub-agent (server-owned, see core/llm_provider.py)
LIGHTING_LLM_PROVIDER=anthropic
LIGHTING_LLM_MODEL=claude-sonnet-4-0
# Provider credentials (set the one matching LIGHTING_LLM_PROVIDER):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Muse Spark 1.3 (OpenAI-compatible endpoint example):
# LIGHTING_LLM_PROVIDER=openai
# LIGHTING_LLM_MODEL=muse-spark-1.3
# OPENAI_API_KEY=<your-muse-spark-key>
# OPENAI_BASE_URL=https://<muse-spark-endpoint>/v1
